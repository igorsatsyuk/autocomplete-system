# Local development only. Do not commit real secrets.
# Copy to `.env` and set a strong password before `docker compose up`.

# Core credentials
POSTGRES_USER=autocomplete
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=autocomplete

# Strict mode profile for Spring services
SPRING_PROFILES_ACTIVE=strict

# Strict mode app connectivity (required)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Optional override: if unset, search-service streams fallback to SPRING_KAFKA_BOOTSTRAP_SERVERS.
# SPRING_KAFKA_STREAMS_BOOTSTRAP_SERVERS=kafka:9092

# Optional datasource settings for non-Compose / IDE runs of search-service.
# In docker-compose, search-service datasource is derived from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/autocomplete
# SPRING_DATASOURCE_USERNAME=autocomplete
# SPRING_DATASOURCE_PASSWORD=change-this-to-a-long-random-password

# Strict mode endpoint exposure (recommended)
SEARCH_MANAGEMENT_ENDPOINTS_EXPOSURE=health,info

# Infra ports (host)
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
POSTGRES_PORT=5432
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
DEBEZIUM_PORT=8083
AUTOCOMPLETE_SERVICE_PORT=8081
SEARCH_SERVICE_PORT=8082
CDC_SERVICE_PORT=8084
FRONTEND_PORT=4200

# Kafka/Debezium runtime settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DEBEZIUM_CONNECTOR_NAME=postgres-connector
DEBEZIUM_CONNECT_URL=http://debezium:8083/connectors
DEBEZIUM_DB_HOST=postgres
DEBEZIUM_DB_PORT=5432
DEBEZIUM_SERVER_NAME=pg
DEBEZIUM_TABLE_INCLUDE_LIST=public.search_stats
DEBEZIUM_SLOT_NAME=autocomplete_slot
DEBEZIUM_PUBLICATION_NAME=autocomplete_pub
DEBEZIUM_TOPIC_PREFIX=db-changes

